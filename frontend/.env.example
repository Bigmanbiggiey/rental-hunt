# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials here or in .env.local
# (coding-standards.md §21).
#
# Only public, client-safe values belong in VITE_-prefixed variables. Never put a
# service_role key, database password, or other private/admin credential here —
# those live exclusively in Edge Function / Supabase project secrets, never in a
# frontend .env file (coding-standards.md §21).

# Supabase (development project) — from the Supabase dashboard:
# Project Settings > API > Project URL, and the anon/public key (or "Publishable
# key" if your project's dashboard uses Supabase's newer API key naming — either
# is the public client key this variable expects, never the secret/service_role key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry (Sprint 10, error monitoring) — a DSN is a public identifier, safe
# in a VITE_-prefixed variable (unlike a service-role key or auth secret).
# Leave blank to disable reporting entirely (shared/lib/sentry.ts no-ops
# without one) — every local/dev environment should leave this blank;
# only the Vercel production environment variable should carry a real value.
VITE_SENTRY_DSN=
